{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Subwoofa",
  "version": "0.1.0",
  "identifier": "dev.subwoofa.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Subwoofa — every channel, every codec",
        "width": 1320,
        "height": 860,
        "minWidth": 1200,
        "minHeight": 780
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Every channel, every codec",
    "copyright": "Subwoofa contributors, GPL-3.0-or-later",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "licenseFile": "../../LICENSE",
    "resources": {
      "installer/fetch-ffmpeg.ps1": "fetch-ffmpeg.ps1",
      "installer/path.ps1": "path.ps1",
      "installer/stage/subwoofa.exe": "subwoofa.exe"
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installMode": "currentUser",
        "installerHooks": "installer/hooks.nsh",
        "template": "installer/installer.nsi",
        "startMenuFolder": "Subwoofa"
      }
    }
  }
}
