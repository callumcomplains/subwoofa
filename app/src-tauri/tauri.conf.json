{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Subwoofa",
  "version": "0.1.0",
  "identifier": "dev.subwoofa.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Subwoofa — every channel, every codec",
        "width": 1320,
        "height": 860,
        "minWidth": 1200,
        "minHeight": 780
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Every channel, every codec",
    "copyright": "Subwoofa contributors, GPL-3.0-or-later",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
